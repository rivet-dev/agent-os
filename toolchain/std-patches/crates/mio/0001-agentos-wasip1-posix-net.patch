     pub(crate) mod tcp {
         use std::io;
+        use std::mem::size_of;
         use std::net::{self, SocketAddr};
+        use std::os::fd::{AsRawFd, FromRawFd};
+
+        #[repr(C)]
+        union SocketAddrCRepr {
+            v4: libc::sockaddr_in,
+            v6: libc::sockaddr_in6,
+        }
+
+        impl SocketAddrCRepr {
+            fn as_ptr(&self) -> *const libc::sockaddr {
+                self as *const _ as *const libc::sockaddr
+            }
+        }
+
+        fn socket_addr(addr: &SocketAddr) -> (SocketAddrCRepr, libc::socklen_t) {
+            match addr {
+                SocketAddr::V4(addr) => (
+                    SocketAddrCRepr {
+                        v4: libc::sockaddr_in {
+                            sin_family: libc::AF_INET as libc::sa_family_t,
+                            sin_port: addr.port().to_be(),
+                            sin_addr: libc::in_addr {
+                                s_addr: u32::from_ne_bytes(addr.ip().octets()),
+                            },
+                        },
+                    },
+                    size_of::<libc::sockaddr_in>() as libc::socklen_t,
+                ),
+                SocketAddr::V6(addr) => (
+                    SocketAddrCRepr {
+                        v6: libc::sockaddr_in6 {
+                            sin6_family: libc::AF_INET6 as libc::sa_family_t,
+                            sin6_port: addr.port().to_be(),
+                            sin6_flowinfo: addr.flowinfo(),
+                            sin6_addr: libc::in6_addr {
+                                s6_addr: addr.ip().octets(),
+                            },
+                            sin6_scope_id: addr.scope_id(),
+                        },
+                    },
+                    size_of::<libc::sockaddr_in6>() as libc::socklen_t,
+                ),
+            }
+        }
+
+        fn cvt(result: libc::c_int) -> io::Result<libc::c_int> {
+            if result < 0 {
+                Err(io::Error::last_os_error())
+            } else {
+                Ok(result)
+            }
+        }
+
+        pub(crate) fn new_for_addr(addr: SocketAddr) -> io::Result<libc::c_int> {
+            let domain = if addr.is_ipv4() { libc::AF_INET } else { libc::AF_INET6 };
+            cvt(unsafe { libc::socket(domain, libc::SOCK_STREAM | libc::SOCK_NONBLOCK, 0) })
+        }
+
+        pub(crate) fn connect(stream: &net::TcpStream, addr: SocketAddr) -> io::Result<()> {
+            let (raw_addr, raw_addr_len) = socket_addr(&addr);
+            let result = unsafe { libc::connect(stream.as_raw_fd(), raw_addr.as_ptr(), raw_addr_len) };
+            match cvt(result) {
+                Err(error) if error.raw_os_error() == Some(libc::EINPROGRESS) => Ok(()),
+                result => result.map(|_| ()),
+            }
+        }
+
+        pub(crate) fn bind(listener: &net::TcpListener, addr: SocketAddr) -> io::Result<()> {
+            let (raw_addr, raw_addr_len) = socket_addr(&addr);
+            cvt(unsafe { libc::bind(listener.as_raw_fd(), raw_addr.as_ptr(), raw_addr_len) })?;
+            Ok(())
+        }
+
+        pub(crate) fn listen(listener: &net::TcpListener, backlog: libc::c_int) -> io::Result<()> {
+            cvt(unsafe { libc::listen(listener.as_raw_fd(), backlog) })?;
+            Ok(())
+        }
+
+        pub(crate) fn set_reuseaddr(listener: &net::TcpListener, reuse: bool) -> io::Result<()> {
+            let value = libc::c_int::from(reuse);
+            cvt(unsafe {
+                libc::setsockopt(
+                    listener.as_raw_fd(),
+                    libc::SOL_SOCKET,
+                    libc::SO_REUSEADDR,
+                    (&raw const value).cast(),
+                    size_of::<libc::c_int>() as libc::socklen_t,
+                )
+            })?;
+            Ok(())
+        }
 
