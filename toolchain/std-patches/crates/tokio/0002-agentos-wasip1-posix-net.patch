         $(
-            #[cfg(all(unix, feature = "net"))]
-            #[cfg_attr(docsrs, doc(cfg(all(unix, feature = "net"))))]
+            #[cfg(all(any(unix, target_os = "wasi"), feature = "net"))]
+            #[cfg_attr(docsrs, doc(cfg(all(any(unix, target_os = "wasi"), feature = "net"))))]
             $item
         )*
     }
@@ -704,12 +704,7 @@
 }
 
