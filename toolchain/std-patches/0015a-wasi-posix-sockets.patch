+// agentOS exposes the supported Unix API names over its WASI/POSIX surface.
+#[cfg(target_os = "wasi")]
+#[stable(feature = "rust1", since = "1.0.0")]
+pub mod unix {
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub use crate::os::wasi::{ffi, fs, io, net};
+}
