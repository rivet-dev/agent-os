+#[cfg(target_os = "wasi")]
+mod host_process {
+    #[link(wasm_import_module = "host_process")]
+    unsafe extern "C" {
+        pub fn fd_flock(fd: u32, operation: u32) -> u32;
+    }
+}
+
+#[cfg(target_os = "wasi")]
+fn agentos_flock(fd: c_int, operation: u32) -> io::Result<()> {
+    // SAFETY: fd_flock accepts a guest fd plus the standard LOCK_* bitmask.
+    let errno = unsafe { host_process::fd_flock(fd as u32, operation) };
+    if errno == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::from_raw_os_error(errno as i32))
+    }
+}
+
+#[cfg(target_os = "wasi")]
