{
	"name": "@agentos-software/apps-builder",
	"version": "0.0.1",
	"type": "module",
	"license": "Apache-2.0",
	"description": "Compatibility tombstone for @rivet-dev/dynamic-apps-builder",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"apps-builder": "./cli/apps-builder.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"cli",
		"dist",
		"agentos-package.json",
		"!dist/package",
		"!dist/package.tar"
	],
	"scripts": {
		"build": "tsc",
		"check-types": "tsc --noEmit",
		"test": "vitest run test/ --passWithNoTests"
	},
	"devDependencies": {
		"@types/node": "^22.19.15",
		"typescript": "^5.7.3",
		"vitest": "^2.1.9"
	}
}
