{
	"name": "@agentos-software/fx",
	"version": "0.0.1",
	"type": "module",
	"license": "Apache-2.0",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"agentos-fx-acp": "./dist/adapter.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/package",
		"!dist/package.tar",
		"!dist/package.aospkg",
		"agentos-package.json"
	],
	"scripts": {
		"build": "rm -rf dist && tsc && node ./scripts/build-fx-wasm.mjs && agentos-toolchain pack . --out dist/package --agent agentos-fx-acp --prune-native --omit-optional",
		"check-types": "tsc --noEmit",
		"test": "pnpm build && node --experimental-wasm-jspi --test tests/*.test.mjs"
	},
	"devDependencies": {
		"@agentos-software/manifest": "workspace:*",
		"@rivet-dev/agentos-toolchain": "workspace:*",
		"@types/node": "^22.10.2",
		"typescript": "^5.7.2"
	}
}
