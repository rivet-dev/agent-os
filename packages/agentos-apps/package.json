{
	"name": "@rivet-dev/agentos-apps",
	"version": "0.0.1",
	"description": "Compatibility tombstone for @rivet-dev/dynamic-apps.",
	"license": "Apache-2.0",
	"type": "module",
	"files": [
		"dist",
		"README.md",
		"package.json"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./advanced": {
			"import": {
				"types": "./dist/advanced.d.ts",
				"default": "./dist/advanced.js"
			}
		}
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"build": "tsup src/index.ts src/advanced.ts --format esm --dts --sourcemap --clean",
		"check-types": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^22.19.15",
		"tsup": "^8.4.0",
		"typescript": "^5.7.3",
		"vitest": "^2.1.8"
	}
}
