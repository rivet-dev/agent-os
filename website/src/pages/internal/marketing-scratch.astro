---
import "../../styles/global.css";
import {
	Cloud,
	Code2,
	Database,
	HardDrive,
	RefreshCw,
	Terminal,
	Users,
	Workflow,
} from "lucide-react";

const pillars = [
	{
		title: "Execution",
		description: "Run the language and tools each task needs.",
		items: [
			{ label: "Node.js", icon: Code2, rotation: "-rotate-6" },
			{ label: "Python", icon: Terminal, rotation: "rotate-6" },
			{ label: "Bash", icon: Terminal, rotation: "-rotate-2" },
		],
	},
	{
		title: "Filesystem",
		description: "Mount durable and remote storage as normal files.",
		items: [
			{ label: "S3", icon: Cloud, rotation: "-rotate-6" },
			{ label: "Host", icon: HardDrive, rotation: "rotate-6" },
			{ label: "SQLite", icon: Database, rotation: "-rotate-2" },
		],
	},
	{
		title: "Orchestration",
		description: "Compose modern agent patterns in code.",
		items: [
			{ label: "Loops", icon: RefreshCw, rotation: "-rotate-6" },
			{ label: "Multiplayer", icon: Users, rotation: "rotate-6" },
			{ label: "Workflows", icon: Workflow, rotation: "-rotate-2" },
		],
	},
];

const variants = [
	{
		key: "s2c3-a",
		label: "S2c.3a",
		title: "Product-first inline",
		description: "Product name, deployment statement, and moving arrow in one undecorated linked line.",
	},
	{
		key: "s2c3-b",
		label: "S2c.3b",
		title: "Statement-first inline",
		description: "The deployment value leads and the product name becomes the quiet trailing action.",
	},
	{
		key: "s2c3-c",
		label: "S2c.3c",
		title: "Compact stack",
		description: "Product and arrow sit above the description in a small centered, undecorated lockup.",
	},
	{
		key: "s2c3-d",
		label: "S2c.3d",
		title: "Relaxed split",
		description: "A wider gap separates the product action from its description without adding a rule or container.",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>S2c.3 Apps CTA Variations — agentOS</title>
	</head>
	<body class="paper-grain min-h-screen bg-paper font-sans text-ink">
		<header class="border-b border-ink/10 px-6 py-14 md:py-20">
			<div class="mx-auto max-w-7xl">
				<p class="font-mono text-[10px] font-medium uppercase tracking-[0.2em] text-pine">Marketing scratch</p>
				<div class="mt-4">
					<div>
						<h1 class="max-w-4xl text-balance text-4xl font-medium tracking-[-0.04em] md:text-6xl">S2c.3 clean CTA variations.</h1>
						<p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">Four undecorated text links with no rules, underlines, icons, or accent color.</p>
					</div>
				</div>
			</div>
		</header>

		<main>
			{variants.map((variant, variantIndex) => (
				<section id={variant.key} class={`scroll-mt-8 border-b border-ink/10 px-6 py-20 md:py-28 ${variantIndex % 2 === 0 ? "bg-paper" : "bg-paper-mid"}`}>
					<div class="mx-auto max-w-7xl">
						<header class="mb-10 flex max-w-3xl items-start gap-4 md:mb-14">
							<span class="flex h-9 min-w-12 shrink-0 items-center justify-center rounded-full border border-pine/20 bg-pine/[0.05] px-2 font-mono text-[10px] font-medium text-pine">{variant.label}</span>
							<div>
								<h2 class="text-2xl font-medium tracking-[-0.025em] md:text-3xl">{variant.title}</h2>
								<p class="mt-2 text-sm leading-relaxed text-ink-soft md:text-base">{variant.description}</p>
							</div>
						</header>

						<div>
							<div class="grid gap-4 md:grid-cols-3">
								{pillars.map((pillar) => (
									<article class="relative aspect-[1.08/1] min-h-[19rem] overflow-hidden rounded-2xl bg-white/75 ring-1 ring-ink/[0.10] shadow-[inset_0_1px_0_rgba(255,255,255,0.95),0_2px_5px_-2px_rgba(20,20,22,0.12),0_18px_40px_-28px_rgba(20,20,22,0.30)]">
										<div aria-hidden="true" class="absolute inset-x-0 top-0 h-[62%]">
											{pillar.items.map(({ label, icon: Icon, rotation }, itemIndex) => (
												<div class={`absolute flex h-20 w-20 flex-col items-center justify-center rounded-2xl bg-ink/[0.035] text-ink-faint ring-1 ring-ink/[0.08] ${rotation} ${itemIndex === 0 ? "left-[9%] top-[12%]" : itemIndex === 1 ? "right-[10%] top-[10%]" : "left-[38%] top-[45%]"}`}>
													<Icon className="h-6 w-6" />
													<span class="mt-1.5 text-[9px] font-medium">{label}</span>
												</div>
											))}
										</div>
										<div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-white via-white/95 to-transparent"></div>
										<div class="absolute inset-x-0 bottom-0 p-7">
											<h3 class="text-2xl font-medium tracking-[-0.02em] md:text-3xl">{pillar.title}</h3>
											<p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-soft md:text-base">{pillar.description}</p>
										</div>
									</article>
								))}
							</div>

							{variant.key === "s2c3-a" && (
								<aside class="mx-auto mt-7 w-fit max-w-full text-center">
									<a href="/docs/apps" class="group inline-flex flex-wrap items-baseline justify-center gap-x-2 gap-y-1 text-xs leading-relaxed text-ink-soft transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine/50 focus-visible:ring-offset-2"><span class="font-medium text-ink">Apps</span><span>Deploy AI-generated applications for each of your users.</span><span aria-hidden="true" class="text-ink-faint transition-transform duration-200 group-hover:translate-x-1">→</span></a>
								</aside>
							)}

							{variant.key === "s2c3-b" && (
								<aside class="mx-auto mt-7 w-fit max-w-full text-center">
									<a href="/docs/apps" class="group inline-flex flex-wrap items-baseline justify-center gap-x-2 gap-y-1 text-xs leading-relaxed text-ink-soft transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine/50 focus-visible:ring-offset-2"><span>Deploy AI-generated applications for each of your users.</span><span class="font-medium text-ink">Apps</span><span aria-hidden="true" class="text-ink-faint transition-transform duration-200 group-hover:translate-x-1">→</span></a>
								</aside>
							)}

							{variant.key === "s2c3-c" && (
								<aside class="mx-auto mt-7 max-w-lg text-center">
									<a href="/docs/apps" class="group inline-flex flex-col items-center text-xs leading-relaxed text-ink-soft transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine/50 focus-visible:ring-offset-2"><span class="inline-flex items-center gap-1.5 font-medium text-ink">Apps <span aria-hidden="true" class="text-ink-faint transition-transform duration-200 group-hover:translate-x-1">→</span></span><span class="mt-1">Deploy AI-generated applications for each of your users.</span></a>
								</aside>
							)}

							{variant.key === "s2c3-d" && (
								<aside class="mx-auto mt-7 max-w-2xl text-center">
									<a href="/docs/apps" class="group inline-flex flex-col items-center gap-1 text-xs leading-relaxed text-ink-soft transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine/50 focus-visible:ring-offset-2 sm:flex-row sm:gap-5"><span class="inline-flex shrink-0 items-center gap-1.5 font-medium text-ink">Apps <span aria-hidden="true" class="text-ink-faint transition-transform duration-200 group-hover:translate-x-1">→</span></span><span>Deploy AI-generated applications for each of your users.</span></a>
								</aside>
							)}

						</div>
					</div>
				</section>
			))}
		</main>
	</body>
</html>
